PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:5173
# Optional: leave empty to automatically run embedded MongoDB Memory Server for seamless testing
MONGODB_URI=mongodb://127.0.0.1:27017/voxa

# ========================================================
# Real Email Sender Configuration (Nodemailer)
# ========================================================

# OPTION 1: Gmail (Quickest setup with App Password)
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an App Name (e.g. "VOXA") and copy the 16-character code
SMTP_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM="VOXA" <your_email@gmail.com>

# OPTION 2: Custom SMTP (Brevo, SendGrid, Mailgun, Amazon SES, or Private Server)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# EMAIL_FROM="VOXA" <no-reply@yourdomain.com>

